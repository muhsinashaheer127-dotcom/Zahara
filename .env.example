# Server Configuration
PORT=5000

# MongoDB Atlas Connection
# Replace <username> and <password> with your actual MongoDB Atlas credentials
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.x8y9cxn.mongodb.net/zahara?retryWrites=true&w=majority&appName=Cluster0

# JWT Secret — must be a long random string, minimum 32 characters
JWT_SECRET=your_secure_jwt_secret_min_32_chars_here

# Frontend API URL (proxied through Vite to the Express server)
VITE_API_URL=/api
